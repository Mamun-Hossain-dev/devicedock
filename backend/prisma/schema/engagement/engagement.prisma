enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum NewsletterBroadcastStatus {
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum NewsletterDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model ContactMessage {
  id        String               @id @default(uuid(7)) @db.Uuid
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id             String                     @id @default(uuid(7)) @db.Uuid
  email          String                     @unique
  name           String?
  status         NewsletterSubscriberStatus @default(ACTIVE)
  userId         String?                    @unique @db.Uuid
  user           User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscribedAt   DateTime                   @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, subscribedAt])
  @@map("newsletter_subscribers")
}

model NewsletterBroadcast {
  id             String                    @id @default(uuid(7)) @db.Uuid
  subject        String
  previewText    String?
  content        String
  status         NewsletterBroadcastStatus @default(SENDING)
  recipientCount Int                       @default(0)
  sentCount      Int                       @default(0)
  failedCount    Int                       @default(0)
  sentAt         DateTime?
  deliveries     NewsletterDelivery[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([createdAt])
  @@map("newsletter_broadcasts")
}

model NewsletterDelivery {
  id          String                   @id @default(uuid(7)) @db.Uuid
  broadcastId String                   @db.Uuid
  email       String
  status      NewsletterDeliveryStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  broadcast   NewsletterBroadcast      @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([broadcastId, email])
  @@index([broadcastId, status])
  @@map("newsletter_deliveries")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(uuid(7)) @db.Uuid
  productId  String       @db.Uuid
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  title      String
  comment    String
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([status, createdAt])
  @@index([productId, status])
  @@map("reviews")
}
